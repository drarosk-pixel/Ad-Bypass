TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
# Optional: comma-separated Telegram numeric user IDs. Empty = everyone allowed.
ALLOWED_USER_IDS=
# Overall resolve timeout (seconds). Browser flow + countdown can take a while.
RESOLVE_TIMEOUT_SECONDS=90
# "false" = headful Chromium (better against Cloudflare; needs a display/xvfb).
# Set "true" only if your host has no display and cannot run xvfb.
HEADLESS=false
